# Local application settings. Copy this file to .env before configuration.
LAITYS_SHOP_NAME=LAITYS - учебный магазин
LAITYS_LOG_LEVEL=INFO
# Set your local PostgreSQL password. Never commit the real .env.
LAITYS_DATABASE_URL=postgresql://laitys:CHANGE_ME@127.0.0.1:5432/laitys
# Optional: separate database for integration tests (not used by the cabinet).
LAITYS_TEST_DATABASE_URL=postgresql://laitys:CHANGE_ME@127.0.0.1:5432/laitys_test
# Windows launcher: start PostgreSQL and keep WSL alive while the site runs.
# Leave empty for PostgreSQL outside WSL; ignored on Linux.
LAITYS_WSL_DISTRIBUTION=Ubuntu
# Optional expenses.json import directory, used only on the first startup.
LAITYS_DATA_DIR=.runtime
